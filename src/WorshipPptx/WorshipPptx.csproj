<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.93.21</Version>
    <AssemblyName>WorshipPptx</AssemblyName>
    <RootNamespace>WorshipPptx</RootNamespace>
    <Title>Worship PPTX</Title>
    <Description>敬拜工坊 — Sunday worship slides</Description>
    <Company>worship-pptx contributors</Company>
    <Product>Worship PPTX</Product>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Windows are constructed with their store/settings dependencies, never by URI. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <OnnxRuntimeVersion Condition="'$(OnnxRuntimeVersion)' == ''">1.31.0</OnnxRuntimeVersion>
    <!-- 1.24+ no longer ships the Intel Mac native runtime. Keep its managed/native pair together. -->
    <OnnxRuntimeVersion Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64')">1.23.2</OnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenccNetLib" Version="1.7.0" ExcludeAssets="contentFiles" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)">
      <!-- NuGet runtime assets select the correct dylib; legacy build props also copy Windows DLLs. -->
      <ExcludeAssets Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">build</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <AvaloniaResource Include="../../assets/fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/app.ico" Link="Assets/app.ico" />
    <AvaloniaResource Include="../../assets/ui/worship-leader-guitar.png" Link="Assets/worship-leader-guitar.png" />
    <Content Include="../../assets/fonts/*" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/media/**/*" Exclude="../../assets/media/provenance/**/*;../../assets/media/generation-prompts.json;../../assets/media/variant-set-*.json;../../assets/media/style-expansion.json;../../assets/media/**/*.partial.*;../../assets/media/**/*.mp4;../../assets/media/**/*.webp;../../assets/media/generic/*.json" Link="Media/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/models/model.onnx;../../assets/models/sentencepiece.bpe.model;../../assets/models/normalization.json;../../assets/models/LICENSE.txt;../../assets/models/THIRD-PARTY-NOTICES.txt" Link="Models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyMacModelRuntime" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">
    <Error Condition="!Exists('$(PublishDir)libonnxruntime.dylib')" Text="Mac publish is missing its native ONNX Runtime library." />
  </Target>
</Project>
