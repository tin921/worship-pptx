<Window x:Class="WorshipPptx.BackgroundDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="編輯背景" Width="620" Height="706" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="Image_Drop" DragOver="Image_DragOver" PreviewKeyDown="Window_KeyDown">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="為詩歌選一張背景" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="圖片會儲存於此電腦，並嵌入 PowerPoint。" Style="{StaticResource Caption}" Margin="0,7,0,20"/></StackPanel>
  <StackPanel Grid.Row="1">
   <Border Height="216" Background="#E7EEE3" CornerRadius="8" ClipToBounds="True"><Grid><Image x:Name="ImagePreview" Stretch="UniformToFill"/><Border Background="#22000000"/><Border Background="#ECFFFFFF" CornerRadius="6" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="將圖片拖到這裡" Foreground="#426B54"/></Border></Grid></Border>
   <Grid Margin="0,16,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BrowseButton" Content="瀏覽本機檔案…" Click="Browse_Click"/><Button x:Name="PasteButton" Grid.Column="2" Content="從剪貼簿貼上  Ctrl+V" Click="Paste_Click"/></Grid>
   <TextBlock Text="或貼上圖片網址" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlText" ToolTip="直接連結圖片的 http(s) 網址"/><Button x:Name="UrlButton" Grid.Column="2" Content="載入圖片" Click="Url_Click"/></Grid>
   <TextBlock Text="PNG、JPEG、BMP、GIF、TIFF · 最大 25 MB&#x0a;圖片會裁切填滿 16:9。請使用有權使用的圖片。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
   <TextBlock x:Name="Message" Foreground="#A34F30" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,20,0,0"><Button Content="使用預設背景" Style="{StaticResource Link}" HorizontalAlignment="Left" Click="Default_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ApplyButton" Content="套用背景" Click="Apply_Click" Style="{StaticResource Primary}"/></StackPanel></Grid>
 </Grid>
</Window>
