<Window Icon="/Assets/app.ico" x:Class="WorshipPptx.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WorshipPptx" Title="敬拜簡報 · Worship PPTX" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EBEFE7" BorderBrush="#DDE4D9" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,12,16,20">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock x:Name="AppHeading" Text="敬拜簡報" FontSize="23" FontWeight="Bold" Margin="0,0,0,3"/>
     <TextBlock Text="WORSHIP PPTX" FontSize="11" Foreground="#738077" Margin="0,0,0,28"/>
     <Button Content="＋ 新增崇拜" Click="NewService_Click" Classes="primary" Padding="8,11" Margin="0,0,0,26"/>
     <TextBlock Text="崇拜紀錄" FontSize="15" Foreground="#738077" Margin="5,0,0,12"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="專心敬拜，輕鬆預備。" FontSize="12" Foreground="#738077" Margin="0,10,0,16"/>
     <Button Content="設定" Click="Settings_Click"/>
     <TextBlock Text="v0.91 預覽 · 本機儲存" Classes="caption" Margin="4,12,0,0"/>
    </StackPanel>
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" SelectionChanged="History_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" Classes.past-service="{Binding IsPast}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplayDate}" FontSize="12" Foreground="#738077" Margin="0,5,0,0"/><TextBlock Text="{Binding TabNames}" FontSize="12" Foreground="#526A59" TextWrapping="Wrap" Margin="0,8,0,4"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <!-- Fit CJK labels and reserve scrollbar space instead of clipping a fixed-height strip. -->
   <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="66"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Border BorderBrush="#C9D3C6" BorderThickness="0,0,0,1" Background="#EEF1EA">
    <DockPanel Margin="20,12,20,0">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Height="56" VerticalAlignment="Top" Margin="0,0,16,0" Spacing="10">
      <TextBox x:Name="ServiceTitle" Width="124" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center" PlaceholderText="崇拜名稱" FontSize="22" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" TextChanged="Metadata_Changed" AutomationProperties.Name="崇拜名稱"/>
      <CalendarDatePicker x:Name="ServiceDate" Width="142" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectedDateChanged="Date_Changed" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" PlaceholderText="崇拜日期" FontSize="14" AutomationProperties.Name="崇拜日期"/>
     </StackPanel>
     <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" VerticalAlignment="Top" VerticalContentAlignment="Top"><TabControl x:Name="SongTabs" BorderThickness="0" Background="Transparent" VerticalAlignment="Top" SelectionChanged="Tab_Changed" DragDrop.AllowDrop="True"  DragDrop.DragOver="Tabs_DragOver" DragDrop.DragLeave="Tabs_DragLeave" DragDrop.Drop="Tabs_Drop" ToolTip.Tip="拖動分頁以調整崇拜次序"><TabControl.Template><ControlTemplate TargetType="TabControl"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ControlTemplate></TabControl.Template><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel></TabControl></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid x:Name="WorkArea" Grid.Row="1" SizeChanged="WorkArea_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="450" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="8"/><ColumnDefinition Width="154" MinWidth="128"/></Grid.ColumnDefinitions>
    <Border Background="#FCFCF9">
     <Grid Margin="20" RowDefinitions="Auto,*,Auto">
      <StackPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SongTitle" AutomationProperties.Name="詩歌或經文名稱" PlaceholderText="詩歌名稱" TextChanged="Editor_Changed"/><Button Grid.Column="1" Content="移除" Classes="link" Padding="10,0,0,0" FontSize="13" Click="RemoveItem_Click"/></Grid>
       <TextBox x:Name="CopyrightText" PlaceholderText="版權資料" TextChanged="Editor_Changed" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBox x:Name="SongId" PlaceholderText="CCLI 詩歌編號（選填）" TextChanged="Editor_Changed" ToolTip.Tip="個別詩歌的 Song Number；教會授權編號請在設定填寫。" Margin="0,0,0,16"/>
       <StackPanel x:Name="OrderPanel"><TextBox x:Name="SongOrder" AutomationProperties.Name="演唱次序" PlaceholderText="演唱次序，例如 v1 c v2 c c" FontSize="16" TextChanged="Editor_Changed" Margin="0,0,0,12"/></StackPanel>
      </StackPanel>
      <TextBox x:Name="Lyrics" Grid.Row="1" AutomationProperties.Name="歌詞或經文" PlaceholderText="歌詞 · 使用 [v1]、[c] 標記段落" MinHeight="260" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="16" TextWrapping="Wrap" TextChanged="Editor_Changed"/>
      <TextBlock x:Name="LyricsHint" Grid.Row="2" Text="[v1]、[c] 標記段落；空行分頁。" Classes="caption" Margin="0,7,0,0"/>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Classes="panelsplitter" AutomationProperties.Name="調整欄位與預覽寬度" ToolTip.Tip="拖動以調整欄位與預覽寬度"/>
     <Grid Grid.Column="2" Margin="18,20,18,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="BackgroundToolbar" ColumnDefinitions="*,16,*" Margin="0,0,0,8">
       <StackPanel>
        <TextBlock Text="背景圖片" Classes="label" Margin="0,0,0,9"/>
        <Border x:Name="BackgroundBox" Height="146" CornerRadius="9" ClipToBounds="True" Background="#D5DFD1" DragDrop.AllowDrop="True" DragDrop.Drop="Background_Drop" DragDrop.DragOver="Background_DragOver">
         <Grid><Image x:Name="BackgroundImage" Stretch="UniformToFill"/><Border Background="#18000000"/><Button Content="編輯背景" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,9" Click="Background_Click" Background="#F4FFFFFF"/></Grid>
        </Border>
        <TextBlock Text="檔案 · 網址 · 拖放 · 貼上" Classes="caption" Margin="0,7,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="2" x:Name="FormattingPanel">
        <TextBlock Text="文字格式" Classes="label" Margin="0,0,0,9"/>
        <ComboBox x:Name="FontPicker" MinWidth="0" Height="40" FontSize="14" Padding="8,7" SelectionChanged="Typography_Changed" ToolTip.Tip="本分頁字體" AutomationProperties.Name="投影片字體"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Grid x:Name="FormattingControls" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,0" SizeChanged="FormattingControls_SizeChanged">
        <WrapPanel x:Name="TypographyRow" Orientation="Horizontal" Margin="0,0,8,0">
         <Button x:Name="TextColorPicker" Classes="palette" Width="56" Height="40" Padding="7" Margin="0,0,6,6" ToolTip.Tip="文字顏色" AutomationProperties.Name="文字顏色">
          <Button.Flyout><Flyout Placement="Bottom"><UniformGrid x:Name="ColorSwatches" Columns="8" Rows="8" Margin="2"/></Flyout></Button.Flyout>
          <Grid ColumnDefinitions="18,4,8"><Border x:Name="SelectedColorSwatch" Width="18" Height="18" CornerRadius="2" BorderBrush="#94A197" BorderThickness="1"/><PathIcon Grid.Column="2" Width="8" Height="6" Data="M0,0 L5,5 L10,0"/></Grid>
         </Button>
         <ComboBox x:Name="FontSizePicker" Width="64" MinWidth="0" Height="40" FontSize="15" Padding="5,7" Margin="0,0,6,6" SelectionChanged="Typography_Changed" ToolTip.Tip="本分頁字號（pt）" AutomationProperties.Name="投影片字號（pt）"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
         <ToggleButton x:Name="BoldToggle" Classes="alignment" Width="36" Margin="0,0,6,6" CornerRadius="6" Content="B" FontWeight="Bold" FontSize="18" Click="FormatOption_Click" ToolTip.Tip="粗體" AutomationProperties.Name="粗體"/>
        </WrapPanel>
        <Grid x:Name="AlignmentControls" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
         <Grid.Styles><Style Selector="ToggleButton.alignment"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/></Style></Grid.Styles>
          <ToggleButton x:Name="AlignLeft" Classes="alignment" Tag="Left" CornerRadius="6,0,0,6" Click="Alignment_Click" ToolTip.Tip="靠左" AutomationProperties.Name="靠左"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M1,6 H13 V8 H1 Z M1,11 H19 V13 H1 Z M1,16 H13 V18 H1 Z"/></ToggleButton>
          <ToggleButton x:Name="AlignCenter" Grid.Column="1" Classes="alignment" Tag="Center" Click="Alignment_Click" ToolTip.Tip="置中" AutomationProperties.Name="置中"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M4,6 H16 V8 H4 Z M1,11 H19 V13 H1 Z M4,16 H16 V18 H4 Z"/></ToggleButton>
          <ToggleButton x:Name="AlignRight" Grid.Column="2" Classes="alignment" Tag="Right" CornerRadius="0,6,6,0" Click="Alignment_Click" ToolTip.Tip="靠右" AutomationProperties.Name="靠右"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M7,6 H19 V8 H7 Z M1,11 H19 V13 H1 Z M7,16 H19 V18 H7 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionTop" Grid.Row="1" Classes="alignment" Tag="Top" CornerRadius="6,0,0,6" Click="Position_Click" ToolTip.Tip="文字靠上" AutomationProperties.Name="文字靠上"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M4,6 H16 V8 H4 Z M4,10 H16 V12 H4 Z M4,14 H16 V16 H4 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionMiddle" Grid.Row="1" Grid.Column="1" Classes="alignment" Tag="Middle" Click="Position_Click" ToolTip.Tip="文字垂直置中" AutomationProperties.Name="文字垂直置中"><PathIcon Width="18" Height="18" Data="M4,4 H16 V6 H4 Z M1,9 H19 V11 H1 Z M4,14 H16 V16 H4 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionBottom" Grid.Row="1" Grid.Column="2" Classes="alignment" Tag="Bottom" CornerRadius="0,6,6,0" Click="Position_Click" ToolTip.Tip="文字靠下" AutomationProperties.Name="文字靠下"><PathIcon Width="18" Height="18" Data="M4,4 H16 V6 H4 Z M4,8 H16 V10 H4 Z M4,12 H16 V14 H4 Z M1,17 H19 V19 H1 Z"/></ToggleButton>
        </Grid>
        </Grid>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,6"><Border DockPanel.Dock="Right" Background="#E9F0E5" CornerRadius="10" Padding="9,3"><TextBlock x:Name="LayoutModeLabel" Text="16:9 · 文字只用上半部" FontSize="12" Foreground="#426B54"/></Border><TextBlock Text="畫面預覽" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <Border Grid.Row="1" Background="#E7EBE2" CornerRadius="8" ClipToBounds="True"><Viewbox x:Name="SlideHost" Stretch="Uniform"/></Border>
       <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
        <ToggleButton x:Name="CompositionToggle" Content="畫面設定" Classes="alignment" IsChecked="False" Width="84" Height="30" MinHeight="0" Padding="8,3" FontSize="13" CornerRadius="6" ToolTip.Tip="顯示／隱藏畫中畫設定" AutomationProperties.Name="畫面設定"/>
        <TextBlock x:Name="PreviewInfo" Grid.Column="1" Classes="caption" Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" Width="36" Height="30" MinHeight="0" Padding="0" Click="Previous_Click" FontSize="18"/><Button Content="›" Width="36" Height="30" MinHeight="0" Padding="0" Margin="7,0,0,0" Click="Next_Click" FontSize="18"/></StackPanel>
       </Grid>
       <local:CompositionControls Grid.Row="3" x:Name="CompositionOptions" IsVisible="{Binding IsChecked, ElementName=CompositionToggle}" Margin="0,6,0,0"/>
       <TextBlock Grid.Row="4" x:Name="ValidationText" Foreground="#A34F30" FontSize="13" Margin="0,6,0,0"/>
      </Grid>
     </Grid>
    <GridSplitter Grid.Column="3" Classes="panelsplitter" AutomationProperties.Name="調整預覽與投影片清單寬度" ToolTip.Tip="拖動以調整預覽與投影片清單寬度"/>
    <DockPanel Grid.Column="4" Margin="10,20,12,16"><TextBlock DockPanel.Dock="Top" Text="投影片" FontSize="16" FontWeight="SemiBold" Margin="3,0,0,12"/><ListBox x:Name="Thumbnails" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single" Classes="thumbnails" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Thumbnail_Changed" KeyDown="Thumbnails_KeyDown" ToolTip.Tip="使用 ↑ ↓ 選擇投影片" AutomationProperties.Name="投影片清單"/></DockPanel>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="已儲存" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="預覽整個崇拜" Click="Preview_Click" Margin="0,0,10,0"/><Button Content="製作 PowerPoint" Click="Export_Click" Classes="primary"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
