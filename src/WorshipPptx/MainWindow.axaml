<Window Icon="/Assets/app.ico" x:Class="WorshipPptx.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WorshipPptx" Title="{local:Tr '敬拜工坊 · Worship PPTX'}" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Window.Styles>
  <!-- Dismissing a font/size list must also deliver the click to its target. -->
  <Style Selector="ComboBox /template/ Popup"><Setter Property="OverlayDismissEventPassThrough" Value="True"/></Style>
 </Window.Styles>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EBEFE7" BorderBrush="#DDE4D9" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,12,16,20">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock x:Name="AppHeading" Text="{local:Tr '敬拜工坊'}" FontSize="23" FontWeight="Bold" Margin="0,0,0,3"/>
     <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="#738077" Margin="0,0,0,10"/>
     <Button x:Name="NewServiceButton" Content="{local:Tr '＋ 新增崇拜'}" Click="NewService_Click" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" Padding="8,0" Margin="0,0,0,10"/>
    </StackPanel>
    <ListBox x:Name="HistoryList" Classes="history" Padding="0" Background="Transparent" BorderThickness="0" SelectionChanged="History_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

     <ListBox.ItemTemplate><DataTemplate><StackPanel>
      <StackPanel IsVisible="{Binding !$parent[ListBoxItem].IsSelected}">
       <TextBlock Text="{Binding Title}" Classes.past-service="{Binding IsPast}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding DisplayDate}" FontSize="12" Foreground="#738077" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding $parent[ListBoxItem].IsSelected}" Spacing="6">
       <TextBox Name="ServiceTitle" Text="{Binding Title, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" MinWidth="0" Height="38" MinHeight="0" Padding="7,0" FontSize="15" FontWeight="SemiBold" TextChanged="Metadata_Changed" AutomationProperties.Name="{local:Tr '崇拜名稱'}"/>
       <CalendarDatePicker Name="ServiceDate" SelectedDate="{Binding Date, Mode=OneWay}" HorizontalAlignment="Stretch" MinWidth="0" Height="38" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" FontSize="13" SelectedDateChanged="Date_Changed" AutomationProperties.Name="{local:Tr '崇拜日期'}"/>
      </StackPanel>
      <TextBlock Text="{Binding TabNames}" FontSize="12" Foreground="#526A59" TextWrapping="Wrap" Margin="0,8,0,4"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <!-- Fit CJK labels and reserve scrollbar space instead of clipping a fixed-height strip. -->
   <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="66"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Border BorderBrush="#C9D3C6" BorderThickness="0,0,0,1" Background="#EEF1EA">
    <DockPanel Margin="20,12,20,0">
     <Border DockPanel.Dock="Right" Height="56" Margin="10,0,0,0" VerticalAlignment="Top">
      <Button x:Name="SettingsButton" Width="40" Height="44" Padding="9" VerticalAlignment="Center" Click="Settings_Click" ToolTip.Tip="{local:Tr '設定'}" AutomationProperties.Name="{local:Tr '設定'}">
       <PathIcon Width="21" Height="21" Data="M9,0 H15 L16,4 L19,5 L23,4 L26,9 L23,12 V15 L26,18 L23,23 L19,22 L16,24 L15,28 H9 L8,24 L5,22 L1,23 L-2,18 L1,15 V12 L-2,9 L1,4 L5,5 L8,4 Z M12,8 A6,6 0 1 0 12,20 A6,6 0 1 0 12,8 Z"/>
      </Button>
     </Border>
     <StackPanel x:Name="LanguagePanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" Height="56" VerticalAlignment="Top" ToolTip.Tip="{local:Tr '切換介面及簡報文字；保留原文'}">
      <ToggleButton x:Name="TraditionalButton" Content="繁體" Tag="zh-Hant" Click="Language_Click" Classes="alignment" Width="58" Height="44" FontSize="18" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="6,0,0,6" AutomationProperties.Name="繁體中文"/>
      <ToggleButton x:Name="SimplifiedButton" Content="简体" Tag="zh-Hans" Click="Language_Click" Classes="alignment" Width="58" Height="44" FontSize="18" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="0,6,6,0" AutomationProperties.Name="简体中文"/>
     </StackPanel>
     <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" VerticalAlignment="Top" VerticalContentAlignment="Top"><TabControl x:Name="SongTabs" BorderThickness="0" Background="Transparent" VerticalAlignment="Top" SelectionChanged="Tab_Changed" DragDrop.AllowDrop="True"  DragDrop.DragOver="Tabs_DragOver" DragDrop.DragLeave="Tabs_DragLeave" DragDrop.Drop="Tabs_Drop" ToolTip.Tip="{local:Tr '拖動分頁以調整崇拜次序'}"><TabControl.Template><ControlTemplate TargetType="TabControl"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ControlTemplate></TabControl.Template><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel></TabControl></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid x:Name="WorkArea" Grid.Row="1" SizeChanged="WorkArea_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="450" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="8"/><ColumnDefinition Width="154" MinWidth="128"/></Grid.ColumnDefinitions>
    <Border Background="#FCFCF9">
     <Grid Margin="20" RowDefinitions="Auto,*,Auto">
      <StackPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SongTitle" AutomationProperties.Name="{local:Tr '詩歌或經文名稱'}" PlaceholderText="{local:Tr '詩歌名稱'}" TextChanged="Editor_Changed"/><Button Grid.Column="1" Content="{local:Tr '移除'}" Classes="link" Padding="10,0,0,0" FontSize="13" Click="RemoveItem_Click"/></Grid>
       <TextBox x:Name="CopyrightText" PlaceholderText="{local:Tr '版權資料'}" TextChanged="Editor_Changed" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBox x:Name="SongId" PlaceholderText="{local:Tr 'CCLI 詩歌編號（選填）'}" TextChanged="Editor_Changed" ToolTip.Tip="{local:Tr '個別詩歌的 Song Number；教會授權編號請在設定填寫。'}" Margin="0,0,0,16"/>
       <StackPanel x:Name="OrderPanel"><TextBox x:Name="SongOrder" AutomationProperties.Name="{local:Tr '演唱次序'}" PlaceholderText="{local:Tr '演唱次序，例如 v1 c v2 c c'}" FontSize="16" TextChanged="Editor_Changed" Margin="0,0,0,12"/></StackPanel>
      </StackPanel>
      <TextBox x:Name="Lyrics" Grid.Row="1" AutomationProperties.Name="{local:Tr '歌詞或經文'}" PlaceholderText="{local:Tr '歌詞 · 使用 [v1]、[c] 標記段落'}" MinHeight="260" AcceptsReturn="True" AcceptsTab="False" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="16" TextWrapping="Wrap" TextChanged="Editor_Changed"/>
      <TextBlock x:Name="LyricsHint" Grid.Row="2" Text="{local:Tr '[v1]、[c] 每段一頁，自動調整字號。'}" Classes="caption" Margin="0,7,0,0"/>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Classes="panelsplitter" AutomationProperties.Name="{local:Tr '調整欄位與預覽寬度'}" ToolTip.Tip="{local:Tr '拖動以調整欄位與預覽寬度'}"/>
     <Grid Grid.Column="2" Margin="18,20,18,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="BackgroundToolbar" ColumnDefinitions="*,16,*" Margin="0,0,0,8">
       <StackPanel>
        <TextBlock Text="{local:Tr '背景圖片'}" Classes="label" Height="28" VerticalAlignment="Center" Margin="0,0,0,9"/>
        <local:SlidePreviewBorder x:Name="BackgroundBox" MaxHeight="200" HorizontalAlignment="Left" CornerRadius="9" ClipToBounds="True" Background="White" BorderBrush="#B0B0B0" BorderThickness="1" DragDrop.AllowDrop="True" DragDrop.Drop="Background_Drop" DragDrop.DragOver="Background_DragOver">
         <Grid><Viewbox x:Name="BackgroundHost" Stretch="Uniform" ToolTip.Tip="{local:Tr '拖動平移 · 滾輪縮放'}"/>
          <Border x:Name="ImageControls" Margin="8" ToolTip.Tip="{local:Tr '拖動平移 · 滾輪縮放'}">
           <Grid>
            <Grid.Styles>
             <Style Selector="Button.image-overlay"><Setter Property="Background" Value="#80000000"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="0"/></Style>
             <Style Selector="Button.image-overlay /template/ ContentPresenter"><Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/><Setter Property="Foreground" Value="White"/></Style>
             <Style Selector="Button.image-overlay:pointerover"><Setter Property="Background" Value="#BB20362B"/></Style>
             <Style Selector="Button.image-overlay:disabled /template/ ContentPresenter"><Setter Property="Opacity" Value="0.45"/></Style>
            </Grid.Styles>
            <Button x:Name="EditBackground" Classes="image-overlay" Content="{local:Tr '編輯'}" Click="Background_Click" Height="36" Padding="13,5" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="{local:Tr '檔案 · 網址 · 拖放 · 貼上'}"/>
            <Viewbox HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0" MaxWidth="144" Width="{Binding #BackgroundBox.Bounds.Width, Converter={x:Static local:HalfWidthConverter.Instance}}" Stretch="Uniform" StretchDirection="DownOnly">
             <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Background="#80000000" CornerRadius="33">
               <Grid x:Name="PanControls" RowDefinitions="22,22,22" ColumnDefinitions="22,22,22">
            <Grid.Styles><Style Selector="Button"><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Style><Style Selector="Button /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Style><Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#663D6750"/></Style><Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Opacity" Value="0.45"/></Style></Grid.Styles>
            <Button x:Name="PanUp" Grid.Column="1" Tag="Up" Click="PanBackground_Click" ToolTip.Tip="{local:Tr '背景向上移動'}" AutomationProperties.Name="{local:Tr '背景向上移動'}"><PathIcon Data="M0,8 L6,2 L12,8 L10,10 L6,6 L2,10 Z"/></Button>
            <Button x:Name="PanLeft" Grid.Row="1" Tag="Left" Click="PanBackground_Click" ToolTip.Tip="{local:Tr '背景向左移動'}" AutomationProperties.Name="{local:Tr '背景向左移動'}"><PathIcon Data="M8,0 L2,6 L8,12 L10,10 L6,6 L10,2 Z"/></Button>
            <Button Grid.Row="1" Grid.Column="1" Padding="2" Click="ResetBackground_Click" ToolTip.Tip="{local:Tr '重設平移及縮放'}" AutomationProperties.Name="{local:Tr '重設平移及縮放'}"><PathIcon Data="M2,7 A6,6 0 0 1 12,3 L14,1 V7 H8 L10,5 A4,4 0 0 0 4,7 Z M14,9 A6,6 0 0 1 4,13 L2,15 V9 H8 L6,11 A4,4 0 0 0 12,9 Z"/></Button>
            <Button x:Name="PanRight" Grid.Row="1" Grid.Column="2" Tag="Right" Click="PanBackground_Click" ToolTip.Tip="{local:Tr '背景向右移動'}" AutomationProperties.Name="{local:Tr '背景向右移動'}"><PathIcon Data="M4,0 L10,6 L4,12 L2,10 L6,6 L2,2 Z"/></Button>
            <Button x:Name="PanDown" Grid.Row="2" Grid.Column="1" Tag="Down" Click="PanBackground_Click" ToolTip.Tip="{local:Tr '背景向下移動'}" AutomationProperties.Name="{local:Tr '背景向下移動'}"><PathIcon Data="M0,4 L6,10 L12,4 L10,2 L6,6 L2,2 Z"/></Button>
               </Grid>
              </Border>
              <StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
               <Button x:Name="ZoomIn" Classes="image-overlay" Width="28" Height="28" Padding="6" CornerRadius="14" Click="ZoomIn_Click" ToolTip.Tip="{local:Tr '放大背景'}" AutomationProperties.Name="{local:Tr '放大背景'}"><PathIcon Data="M0,5 H5 V0 H7 V5 H12 V7 H7 V12 H5 V7 H0 Z"/></Button>
               <Button x:Name="ZoomOut" Classes="image-overlay" Width="28" Height="28" Padding="6" CornerRadius="14" Click="ZoomOut_Click" ToolTip.Tip="{local:Tr '縮小背景'}" AutomationProperties.Name="{local:Tr '縮小背景'}"><PathIcon Data="M0,5 H12 V7 H0 Z"/></Button>
               </StackPanel>
              <StackPanel VerticalAlignment="Center"><ToggleButton x:Name="FlipBackground" Width="28" Height="28" MinHeight="0" Padding="5" CornerRadius="14" Background="#80000000" Foreground="White" BorderThickness="0" Click="FlipBackground_Click" ToolTip.Tip="{local:Tr '水平翻轉'}" AutomationProperties.Name="{local:Tr '水平翻轉'}"><ToggleButton.Styles><Style Selector="ToggleButton /template/ ContentPresenter"><Setter Property="Background" Value="#80000000"/><Setter Property="Foreground" Value="White"/></Style><Style Selector="ToggleButton:checked /template/ ContentPresenter"><Setter Property="Background" Value="#CC28543E"/></Style></ToggleButton.Styles><PathIcon Data="M8,0 H10 V18 H8 Z M0,4 L6,9 L0,14 Z M18,4 V14 L12,9 Z"/></ToggleButton>
              </StackPanel>
             </StackPanel>
            </Viewbox>
            <Grid x:Name="OpacityControls" ColumnDefinitions="*,32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="40" Width="{Binding #BackgroundBox.Bounds.Width, Converter={x:Static local:HalfWidthConverter.Instance}}">
             <Slider x:Name="BackgroundOpacity" Margin="0" Minimum="0" Maximum="100" Value="100" ValueChanged="BackgroundOpacity_Changed" ToolTip.Tip="{local:Tr '背景不透明度'}" AutomationProperties.Name="{local:Tr '背景不透明度'}"/>
             <Border Grid.Column="1" Background="#80000000" CornerRadius="4" Padding="3,2" VerticalAlignment="Center"><TextBlock x:Name="OpacityLabel" Text="100%" FontSize="10" Foreground="White" TextAlignment="Center"/></Border>
            </Grid>
           </Grid>
          </Border>
         </Grid>
        </local:SlidePreviewBorder>
       </StackPanel>
       <StackPanel Grid.Column="2" x:Name="FormattingPanel">
        <Grid ColumnDefinitions="*,Auto" Height="28" Margin="0,0,0,9"><TextBlock Text="{local:Tr '文字格式'}" Classes="label" VerticalAlignment="Center"/><TextBlock x:Name="FontSizeScope" Grid.Column="1" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
        <ComboBox x:Name="FontPicker" MinWidth="0" Height="40" FontSize="14" Padding="8,7" SelectionChanged="Typography_Changed" ToolTip.Tip="{local:Tr '本分頁字體'}" AutomationProperties.Name="{local:Tr '投影片字體'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Grid x:Name="FormattingControls" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,0" SizeChanged="FormattingControls_SizeChanged">
        <Grid x:Name="TypographyRow" ColumnDefinitions="Auto,Auto" RowDefinitions="40,40" ColumnSpacing="6" RowSpacing="8" Margin="0,0,8,0" HorizontalAlignment="Left">
         <ToggleButton x:Name="AutoFontSizeButton" Classes="alignment" Width="56" Height="40" CornerRadius="6" Content="{local:Tr '自動'}" Padding="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AutoFontSize_Click" ToolTip.Tip="{local:Tr '按最長歌詞段落統一字號；持續自動調整，直至選擇固定字號'}" AutomationProperties.Name="{local:Tr '自動字號'}"/>
         <ComboBox x:Name="FontSizePicker" Grid.Column="1" Width="64" MinWidth="0" Height="40" FontSize="15" Padding="5,7" SelectionChanged="Typography_Changed" ToolTip.Tip="{local:Tr '本分頁字號（pt）'}" AutomationProperties.Name="{local:Tr '投影片字號（pt）'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
         <Button x:Name="TextColorPicker" Grid.Row="1" Classes="palette" Width="56" Height="40" Padding="7" ToolTip.Tip="{local:Tr '文字顏色'}" AutomationProperties.Name="{local:Tr '文字顏色'}">
          <Button.Flyout><Flyout Placement="Bottom" OverlayDismissEventPassThrough="True"><UniformGrid x:Name="ColorSwatches" Columns="8" Rows="8" Margin="2"/></Flyout></Button.Flyout>
          <Grid ColumnDefinitions="18,4,8"><Border x:Name="SelectedColorSwatch" Width="18" Height="18" CornerRadius="2" BorderBrush="#94A197" BorderThickness="1"/><PathIcon Grid.Column="2" Width="8" Height="6" Data="M0,0 L5,5 L10,0"/></Grid>
         </Button>
         <ToggleButton x:Name="BoldToggle" Grid.Row="1" Grid.Column="1" Classes="alignment" Width="64" CornerRadius="6" Content="B" FontWeight="Bold" FontSize="18" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="FormatOption_Click" ToolTip.Tip="{local:Tr '粗體'}" AutomationProperties.Name="{local:Tr '粗體'}"/>
        </Grid>
        <Grid x:Name="AlignmentControls" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
         <Grid.Styles><Style Selector="ToggleButton.alignment"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/></Style></Grid.Styles>
          <ToggleButton x:Name="AlignLeft" Classes="alignment" Tag="Left" CornerRadius="6,0,0,6" Click="Alignment_Click" ToolTip.Tip="{local:Tr '靠左'}" AutomationProperties.Name="{local:Tr '靠左'}"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M1,6 H13 V8 H1 Z M1,11 H19 V13 H1 Z M1,16 H13 V18 H1 Z"/></ToggleButton>
          <ToggleButton x:Name="AlignCenter" Grid.Column="1" Classes="alignment" Tag="Center" Click="Alignment_Click" ToolTip.Tip="{local:Tr '置中'}" AutomationProperties.Name="{local:Tr '置中'}"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M4,6 H16 V8 H4 Z M1,11 H19 V13 H1 Z M4,16 H16 V18 H4 Z"/></ToggleButton>
          <ToggleButton x:Name="AlignRight" Grid.Column="2" Classes="alignment" Tag="Right" CornerRadius="0,6,6,0" Click="Alignment_Click" ToolTip.Tip="{local:Tr '靠右'}" AutomationProperties.Name="{local:Tr '靠右'}"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M7,6 H19 V8 H7 Z M1,11 H19 V13 H1 Z M7,16 H19 V18 H7 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionTop" Grid.Row="1" Classes="alignment" Tag="Top" CornerRadius="6,0,0,6" Click="Position_Click" ToolTip.Tip="{local:Tr '文字靠上'}" AutomationProperties.Name="{local:Tr '文字靠上'}"><PathIcon Width="18" Height="18" Data="M1,1 H19 V3 H1 Z M4,6 H16 V8 H4 Z M4,10 H16 V12 H4 Z M4,14 H16 V16 H4 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionMiddle" Grid.Row="1" Grid.Column="1" Classes="alignment" Tag="Middle" Click="Position_Click" ToolTip.Tip="{local:Tr '文字垂直置中'}" AutomationProperties.Name="{local:Tr '文字垂直置中'}"><PathIcon Width="18" Height="18" Data="M4,4 H16 V6 H4 Z M1,9 H19 V11 H1 Z M4,14 H16 V16 H4 Z"/></ToggleButton>
         <ToggleButton x:Name="PositionBottom" Grid.Row="1" Grid.Column="2" Classes="alignment" Tag="Bottom" CornerRadius="0,6,6,0" Click="Position_Click" ToolTip.Tip="{local:Tr '文字靠下'}" AutomationProperties.Name="{local:Tr '文字靠下'}"><PathIcon Width="18" Height="18" Data="M4,4 H16 V6 H4 Z M4,8 H16 V10 H4 Z M4,12 H16 V14 H4 Z M1,17 H19 V19 H1 Z"/></ToggleButton>
        </Grid>
        </Grid>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="PreviewHeader" ColumnDefinitions="*,Auto" Margin="0,12,0,8">
        <TextBlock Text="{local:Tr '畫面預覽'}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="PreviewInfo" Classes="caption" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="PreviousPreview" Content="‹" Width="36" Height="30" MinHeight="0" Padding="0" Click="Previous_Click" FontSize="18"/><Button x:Name="NextPreview" Content="›" Width="36" Height="30" MinHeight="0" Padding="0" Margin="7,0,0,0" Click="Next_Click" FontSize="18"/></StackPanel>
       </Grid>
       <local:SlidePreviewBorder x:Name="ProjectionBox" Grid.Row="1" BorderBrush="#B0B0B0" BorderThickness="1"><Viewbox x:Name="SlideHost" Stretch="Uniform" VerticalAlignment="Top"/></local:SlidePreviewBorder>
       <TextBlock Grid.Row="4" x:Name="ValidationText" Foreground="#A34F30" FontSize="13" Margin="0,6,0,0"/>
      </Grid>
     </Grid>
    <GridSplitter Grid.Column="3" Classes="panelsplitter" AutomationProperties.Name="{local:Tr '調整預覽與投影片清單寬度'}" ToolTip.Tip="{local:Tr '拖動以調整預覽與投影片清單寬度'}"/>
    <DockPanel Grid.Column="4" Margin="10,20,12,16"><TextBlock DockPanel.Dock="Top" Text="{local:Tr '投影片'}" FontSize="16" FontWeight="SemiBold" Margin="3,0,0,12"/><ListBox x:Name="Thumbnails" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single" Classes="thumbnails" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Thumbnail_Changed" ToolTip.Tip="{local:Tr '使用 ↑ ↓ 選擇投影片'}" AutomationProperties.Name="{local:Tr '投影片清單'}"><ListBox.Resources><x:Double x:Key="ScrollBarSize">8</x:Double><x:Double x:Key="ScrollBarButtonArrowIconFontSize">6</x:Double></ListBox.Resources></ListBox></DockPanel>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="{local:Tr '已儲存'}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
      <StackPanel.Styles>
       <Style Selector="Button"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#A7BBAC"/><Setter Property="BorderBrush" Value="#A7BBAC"/><Setter Property="Foreground" Value="#20362B"/></Style>
       <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#98AE9E"/><Setter Property="BorderBrush" Value="#98AE9E"/><Setter Property="Foreground" Value="#20362B"/></Style>
       <Style Selector="Button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#8BA592"/><Setter Property="BorderBrush" Value="#8BA592"/><Setter Property="Foreground" Value="#20362B"/></Style>
      </StackPanel.Styles>
      <Button x:Name="PreviewButton" Content="{local:Tr '預覽'}" Click="Preview_Click" ToolTip.Tip="{local:Tr '預覽整個崇拜'}" AutomationProperties.Name="{local:Tr '預覽整個崇拜'}"/>
      <Button x:Name="ExportButton" Content="{local:Tr '製作'}" Click="Export_Click" ToolTip.Tip="{local:Tr '製作 PowerPoint'}" AutomationProperties.Name="{local:Tr '製作 PowerPoint'}"/>
      <Button x:Name="UploadButton" Content="{local:Tr '上傳'}" Click="Upload_Click" ToolTip.Tip="{local:Tr '上傳 Google Drive'}" AutomationProperties.Name="{local:Tr '上傳 Google Drive'}"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
