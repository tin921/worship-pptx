<Window x:Class="WorshipPptx.SettingsDialog" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WorshipPptx" Title="{local:Tr '設定'}" Width="620" Height="460" MinHeight="460" CanResize="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
  <TextBlock Text="{local:Tr '教會設定'}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,24"/>
  <TextBox x:Name="LicenseText" PlaceholderText="{local:Tr '教會 CCLI 授權編號（選填）'}"/><TextBlock Text="{local:Tr '此編號會顯示於詩歌投影片；與個別詩歌編號不同。'}" Classes="caption" Margin="0,6,0,22"/>
  <TextBlock Text="{local:Tr 'PowerPoint 儲存資料夾'}" Margin="0,0,0,6"/>
  <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="SaveFolder" AutomationProperties.Name="{local:Tr 'PowerPoint 儲存資料夾'}"/><Button Grid.Column="1" Content="…" Click="Browse_Click" Margin="8,0,0,0" AutomationProperties.Name="{local:Tr '選擇儲存資料夾'}"/></Grid>
  <TextBlock Text="{local:Tr '製作時預設此資料夾；上傳前會在此保留本機副本。'}" Classes="caption" Margin="0,6,0,12"/>
  <TextBlock Text="{local:Tr '隨附的中文字體會完整嵌入 PowerPoint。使用本機字體時，播放電腦需備有相同字體。'}" Classes="caption" Margin="0,10,0,0"/>
 </StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Tr '取消'}" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="{local:Tr '儲存設定'}" Click="Save_Click" Classes="primary"/></StackPanel></Grid>
</Window>
