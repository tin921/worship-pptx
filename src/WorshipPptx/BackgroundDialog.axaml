<Window x:Class="WorshipPptx.BackgroundDialog" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WorshipPptx" Title="{local:Tr '選擇背景'}" Width="1080" Height="800" MinWidth="880" MinHeight="680" WindowStartupLocation="CenterOwner" DragDrop.AllowDrop="True" DragDrop.Drop="Image_Drop" DragDrop.DragOver="Image_DragOver" KeyDown="Window_KeyDown">
 <Grid>
 <Grid x:Name="DialogContent" Margin="24" RowDefinitions="Auto,*,Auto,Auto">
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{local:Tr '為詩歌選一張背景'}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{local:Tr '開啟時以歌名及歌詞配對主題；亦可輸入中文或英文，按「搜尋」配對內置背景。'}" Classes="caption" Margin="0,7,0,0"/></StackPanel>
  <Grid Grid.Row="1" ColumnDefinitions="*,24,300">
   <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,10,Auto"><TextBox x:Name="SearchText" PlaceholderText="{local:Tr '圖片主題、關鍵字 · 中文或英文'}" MaxLength="500" TextWrapping="Wrap" MaxHeight="90" TextChanged="Keywords_Changed" ToolTip.Tip="{local:Tr 'Google 預設只搜尋英文主題；修改後最多使用三組關鍵字'}"/><Button x:Name="SearchButton" Grid.Column="2" Content="{local:Tr '搜尋'}" Click="Search_Click" Classes="primary" VerticalAlignment="Top"/></Grid>
    <Grid x:Name="GalleryToolbar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,12" SizeChanged="GalleryToolbar_SizeChanged">
     <StackPanel x:Name="CollectionButtons" Orientation="Horizontal" VerticalAlignment="Center">
      <ToggleButton x:Name="MatchedFilter" Content="{local:Tr '主題配對'}" Classes="alignment" Width="80" Height="54" Padding="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsChecked="True" CornerRadius="6,0,0,6" Click="Collection_Click"/>
      <ToggleButton x:Name="GenericFilter" Content="{local:Tr '通用背景'}" Classes="alignment" Width="80" Height="54" Padding="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="0,6,6,0" Click="Collection_Click"/>
     </StackPanel>
     <StackPanel x:Name="GalleryCounts" Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="GalleryInfo" FontSize="18" FontWeight="Bold" Foreground="#1666B3" TextAlignment="Center"/>
     </StackPanel>
     <WrapPanel x:Name="StyleFilters" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer x:Name="GalleryScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" AllowAutoHide="False" Focusable="True"><WrapPanel x:Name="Gallery" Orientation="Horizontal" Margin="0,0,8,0"/></ScrollViewer>
   </Grid>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10">
    <TextBlock x:Name="MatchedTheme" Text="{local:Tr '正在準備圖片關鍵字…'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <HyperlinkButton x:Name="GoogleImageLink" Content="{local:Tr 'Google 圖片搜尋 ↗'}" Classes="link" IsEnabled="False" HorizontalAlignment="Left" ToolTip.Tip="{local:Tr '以精簡英文主題搜尋崇拜投影片背景'}"/>
    <TextBlock Text="{local:Tr '以英文主題尋找崇拜投影片背景，優先大型橫向圖片。下載後請確認達 1280 × 720。'}" Classes="caption" TextWrapping="Wrap"/>
    <Border Height="169" Background="#E7EEE3" CornerRadius="8" ClipToBounds="True"><Image x:Name="ImagePreview" Stretch="UniformToFill"/></Border>
    <TextBlock x:Name="SelectedTitle" Text="{local:Tr '目前背景'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{local:Tr '或使用自己的圖片'}" FontSize="17" Margin="0,14,0,0"/>
    <Grid ColumnDefinitions="*,8,*"><Button x:Name="BrowseButton" Content="{local:Tr '本機檔案…'}" Click="Browse_Click" HorizontalAlignment="Stretch"/><Button x:Name="PasteButton" Grid.Column="2" Content="{local:Tr '貼上圖片'}" ToolTip.Tip="Ctrl / ⌘ + V" Click="Paste_Click" HorizontalAlignment="Stretch"/></Grid>
    <Grid ColumnDefinitions="*,8,Auto"><TextBox x:Name="UrlText" PlaceholderText="{local:Tr '圖片網址 · https://…'}" ToolTip.Tip="{local:Tr '直接連結圖片的 http(s) 網址'}"/><Button x:Name="UrlButton" Grid.Column="2" Content="{local:Tr '載入'}" Click="Url_Click"/></Grid>
    <Border BorderBrush="#CBD6CB" BorderThickness="1" CornerRadius="8" Padding="16"><TextBlock Text="{local:Tr '也可以將圖片拖到此視窗&#x0a;PNG、JPEG、WebP、BMP、GIF · 最大 25 MB'}" Classes="caption" TextWrapping="Wrap"/></Border>
    <TextBlock Text="{local:Tr '圖片會裁切填滿 16:9，並嵌入 PowerPoint。'}" Classes="caption" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Message" IsVisible="False" Foreground="#A34F30" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Tr '取消'}" Click="Cancel_Click" Margin="0,0,10,0"/><Button x:Name="ApplyButton" Content="{local:Tr '套用背景'}" Click="Apply_Click" Classes="primary"/></StackPanel>
 </Grid>
 <Border x:Name="MatchingStatus" IsVisible="False" Background="#80000000">
  <Border x:Name="MatchingCard" Width="420" Margin="24" Padding="28" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel Spacing="16">
    <TextBlock Text="{local:Tr '正在擷取主題及關鍵字…'}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
    <TextBlock x:Name="MatchProgressMessage" Text="{local:Tr '正在準備分析…'}" TextWrapping="Wrap" TextAlignment="Center"/>
    <ProgressBar x:Name="MatchProgressBar" Minimum="0" Maximum="100" Height="8" IsIndeterminate="True"/>
    <TextBlock x:Name="MatchProgressPercent" Text="" FontSize="18" TextAlignment="Center"/>
    <Button Content="{local:Tr '取消'}" Click="Cancel_Click" HorizontalAlignment="Center"/>
   </StackPanel>
  </Border>
 </Border>
 </Grid>
</Window>
