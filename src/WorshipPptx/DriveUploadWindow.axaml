<Window x:Class="WorshipPptx.DriveUploadWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WorshipPptx" Title="{local:Tr '上傳 Google Drive'}" Width="760" Height="650" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <TextBlock Text="{local:Tr '上傳 Google Drive'}" FontSize="24" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="{local:Tr '檔案名稱（可修改）'}"/><TextBox x:Name="UploadName" AutomationProperties.Name="{local:Tr '上傳檔案名稱'}"/><TextBlock Text="{local:Tr '日期為即將到來的星期日；M 普通話，C 粵語；call+ 表示首項為宣召經文。'}" TextWrapping="Wrap" Classes="caption"/></StackPanel>
  <CheckBox Grid.Row="2" x:Name="ReplaceExisting" Content="{local:Tr '取代同名檔案（取消勾選則保留兩份）'}" IsChecked="True"/>
  <StackPanel Grid.Row="3" Spacing="6"><TextBlock x:Name="StepLabel" TextWrapping="Wrap"/><ProgressBar x:Name="UploadProgressBar" Minimum="0" Maximum="100" Height="8"/></StackPanel>
  <TextBox Grid.Row="4" x:Name="UploadLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Tr '上傳記錄'}"/>
  <StackPanel Grid.Row="5" Spacing="6"><TextBlock x:Name="Outcome" TextWrapping="Wrap"/><HyperlinkButton x:Name="FolderLink" Content="{local:Tr '開啟 Google Drive 資料夾，確認檔案 ↗'}" IsVisible="False"/></StackPanel>
  <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto,Auto"><Button x:Name="CopyLog" Content="{local:Tr '複製全部記錄'}" Click="Copy_Click"/><Button x:Name="CloseUpload" Grid.Column="2" Content="{local:Tr '關閉'}" Click="Close_Click" Margin="0,0,10,0"/><Button x:Name="StartUpload" Grid.Column="3" Content="{local:Tr '上傳'}" Classes="primary" Click="Upload_Click"/></Grid>
 </Grid>
</Window>
