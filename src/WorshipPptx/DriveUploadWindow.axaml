<Window x:Class="WorshipPptx.DriveUploadWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WorshipPptx" Title="{local:Tr '上傳 Google Drive'}" Width="760" Height="760" MinWidth="620" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <TextBlock Text="{local:Tr '上傳 Google Drive'}" FontSize="24" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="{local:Tr '檔案名稱（可修改）'}"/><TextBox x:Name="UploadName" AutomationProperties.Name="{local:Tr '上傳檔案名稱'}"/><TextBlock Text="{local:Tr '日期為即將到來的星期日；m 普通話，c 粵語；call+ 表示首項為宣召經文。'}" TextWrapping="Wrap" Classes="caption"/></StackPanel>
  <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="{local:Tr '本機儲存資料夾（修改後會記住）'}"/><Grid ColumnDefinitions="*,Auto"><TextBox x:Name="UploadFolder" AutomationProperties.Name="{local:Tr '本機儲存資料夾'}"/><Button x:Name="BrowseFolder" Grid.Column="1" Content="…" Click="Browse_Click" Margin="8,0,0,0" AutomationProperties.Name="{local:Tr '選擇儲存資料夾'}"/></Grid><TextBlock Text="{local:Tr '先儲存本機副本，再上傳；雲端清理不會刪除本機副本。'}" Classes="caption"/></StackPanel>
  <CheckBox Grid.Row="3" x:Name="ReplaceExisting" Content="{local:Tr '取代本機及雲端的同名檔案（取消勾選則保留兩份）'}" IsChecked="True"/>
  <StackPanel Grid.Row="4" Spacing="6"><TextBlock x:Name="StepLabel" TextWrapping="Wrap"/><ProgressBar x:Name="UploadProgressBar" Minimum="0" Maximum="100" Height="8"/></StackPanel>
  <TextBox Grid.Row="5" x:Name="UploadLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Tr '上傳記錄'}"/>
  <StackPanel Grid.Row="6" Spacing="6"><TextBlock x:Name="Outcome" TextWrapping="Wrap"/><HyperlinkButton x:Name="FolderLink" Content="{local:Tr '開啟 Google Drive 資料夾，確認檔案 ↗'}" IsVisible="False"/></StackPanel>
  <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto,Auto"><Button x:Name="CopyLog" Content="{local:Tr '複製全部記錄'}" Click="Copy_Click"/><Button x:Name="CloseUpload" Grid.Column="2" Content="{local:Tr '關閉'}" Click="Close_Click" Margin="0,0,10,0"/><Button x:Name="StartUpload" Grid.Column="3" Content="{local:Tr '上傳'}" Classes="primary" Click="Upload_Click"/></Grid>
 </Grid>
</Window>
