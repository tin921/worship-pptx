<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorshipPptx.App" RequestedThemeVariant="Light">
 <Application.Resources>
  <SolidColorBrush x:Key="Line">#DFE6DF</SolidColorBrush>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme>
   <FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#426B54"/></FluentTheme.Palettes>
  </FluentTheme>
  <Style Selector="Window"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#20362B"/><Setter Property="FontFamily" Value="avares://WorshipPptx/Fonts#Noto Sans CJK HK"/><Setter Property="FontSize" Value="15"/></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#738077"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.past-service"><Setter Property="Foreground" Value="#8A918C"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="15,10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE6DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#426B54"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#426B54"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#345842"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#426B54"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style Selector="Button.palette"><Setter Property="Template"><ControlTemplate><Border Name="PaletteBorder" CornerRadius="6" Background="White" BorderBrush="#819587" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DFE6DF"/><Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="White"/></Style>
  <Style Selector="NumericUpDown /template/ TextBox"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style Selector="ToggleButton.alignment"><Setter Property="Width" Value="32"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CDD8C9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#697B6D"/></Style>
  <Style Selector="ToggleButton.alignment:checked /template/ ContentPresenter"><Setter Property="Background" Value="#E1EDE4"/><Setter Property="BorderBrush" Value="#426B54"/><Setter Property="Foreground" Value="#28543E"/></Style>
  <Style Selector="GridSplitter.panelsplitter"><Setter Property="Background" Value="#F1F4EE"/><Setter Property="ResizeDirection" Value="Columns"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
  <Style Selector="GridSplitter.panelsplitter:pointerover"><Setter Property="Background" Value="#A7BCAA"/></Style>
  <Style Selector="TabItem"><Setter Property="Height" Value="56"/><Setter Property="Padding" Value="18,0"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Background" Value="#E5EBE0"/><Setter Property="BorderBrush" Value="#CDD8C9"/><Setter Property="BorderThickness" Value="1,1,1,0"/><Setter Property="Foreground" Value="#697B6D"/>
   <Setter Property="Template"><ControlTemplate><Border Name="TabBorder" CornerRadius="7,7,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="TabItem:selected"><Setter Property="Background" Value="#28543E"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderBrush" Value="#173D2B"/><Setter Property="BorderThickness" Value="1,3,1,0"/></Style>
  <Style Selector="TabItem:pointerover"><Setter Property="Background" Value="#F5F8F2"/></Style>
  <Style Selector="TabItem:selected:pointerover"><Setter Property="Background" Value="#28543E"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="TabItem.add-tab"><Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="#426B54"/><Setter Property="Background" Value="#F5F7F1"/></Style>
  <Style Selector="TabItem.drop-before"><Setter Property="BorderThickness" Value="3,1,1,0"/><Setter Property="BorderBrush" Value="#426B54"/></Style>
  <Style Selector="TabItem.drop-after"><Setter Property="BorderThickness" Value="1,1,3,0"/><Setter Property="BorderBrush" Value="#426B54"/></Style>
  <Style Selector="ListBox.thumbnails > ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderBrush" Value="#DFE6DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="ListBox.thumbnails > ListBoxItem:selected"><Setter Property="BorderBrush" Value="#426B54"/><Setter Property="Background" Value="#EDF3EA"/></Style>
  <Style Selector="ListBox.history > ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Application.Styles>
</Application>
