<Window x:Class="WorshipPptx.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="敬拜簡報 · Worship PPTX" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EBEFE7" BorderBrush="#DDE4D9" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,24,16,20">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="✦" FontSize="32" Foreground="#426B54"/>
     <TextBlock Text="敬拜簡報" FontSize="23" FontWeight="Bold" Margin="0,6,0,3"/>
     <TextBlock Text="WORSHIP PPTX" FontSize="11" Foreground="#738077" Margin="0,0,0,28"/>
     <Button Content="＋ 新增崇拜" Click="NewService_Click" Style="{StaticResource Primary}" Padding="8,11" Margin="0,0,0,26"/>
     <TextBlock Text="崇拜紀錄" FontSize="15" Foreground="#738077" Margin="5,0,0,12"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="專心敬拜，輕鬆預備。" FontSize="12" Foreground="#738077" Margin="0,10,0,16"/>
     <Button Content="設定" Click="Settings_Click"/>
     <TextBlock Text="v1.0.0 · 本機儲存" Style="{StaticResource Caption}" Margin="4,12,0,0"/>
    </StackPanel>
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" SelectionChanged="History_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,10"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayDate}" FontSize="12" Foreground="#738077" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#E7ECE3">
    <DockPanel Margin="20,13,20,0">
     <Button DockPanel.Dock="Right" Content="＋ 加詩歌" Click="AddSong_Click" Style="{StaticResource Link}" Margin="8,0,0,8"/>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><TabControl x:Name="SongTabs" BorderThickness="0" Background="Transparent" SelectionChanged="Tab_Changed"><TabControl.Template><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True"/></ControlTemplate></TabControl.Template></TabControl></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#FCFCF9">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,20,20,20">
       <TextBlock Text="崇拜安排" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
       <TextBox x:Name="ServiceTitle" FontSize="25" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,0,0,5" TextChanged="Metadata_Changed"/>
       <DatePicker x:Name="ServiceDate" SelectedDateChanged="Date_Changed" FontSize="14" HorizontalAlignment="Stretch"/>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,18"/>
       <Grid Margin="0,0,0,8"><TextBlock x:Name="TitleLabel" Text="詩歌名稱" Style="{StaticResource Label}" Margin="0"/><Button Content="移除" HorizontalAlignment="Right" Style="{StaticResource Link}" Padding="0" FontSize="12" Click="RemoveItem_Click"/></Grid>
       <TextBox x:Name="SongTitle" TextChanged="Editor_Changed"/>
       <TextBlock x:Name="LyricsLabel" Text="歌詞" Style="{StaticResource Label}" Margin="0,18,0,7"/>
       <TextBox x:Name="Lyrics" Height="240" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="16" TextWrapping="Wrap" TextChanged="Editor_Changed" SpellCheck.IsEnabled="False"/>
       <TextBlock x:Name="LyricsHint" Text="[v1]、[c] 標記段落；空行分頁。" Style="{StaticResource Caption}" Margin="0,7,0,16"/>
       <StackPanel x:Name="OrderPanel"><TextBlock Text="演唱次序" Style="{StaticResource Label}"/><TextBox x:Name="SongOrder" FontFamily="Consolas" FontSize="17" TextChanged="Editor_Changed"/><TextBlock Text="直接輸入，例如 v1 c v2 c c。" Style="{StaticResource Caption}" Margin="0,7,0,16"/></StackPanel>
       <TextBlock Text="版權資料" Style="{StaticResource Label}"/><TextBox x:Name="CopyrightText" TextChanged="Editor_Changed" TextWrapping="Wrap"/>
       <TextBlock Text="CCLI 詩歌編號" Style="{StaticResource Label}" Margin="0,16,0,8"/><TextBox x:Name="SongId" TextChanged="Editor_Changed" ToolTip="個別詩歌的 Song Number；教會授權編號請在設定填寫。"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Margin="24,20,20,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
       <DockPanel Margin="0,0,0,9"><TextBlock DockPanel.Dock="Right" Text="檔案 · 網址 · 拖放 · 貼上" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="背景圖片" Style="{StaticResource Label}" Margin="0"/></DockPanel>
       <Border Height="146" CornerRadius="9" ClipToBounds="True" Background="#D5DFD1" AllowDrop="True" Drop="Background_Drop" DragOver="Background_DragOver">
        <Grid><Image x:Name="BackgroundImage" Stretch="UniformToFill"/><Border Background="#18000000"/><Button Content="編輯背景" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,11" Click="Background_Click" Background="#F4FFFFFF"/></Grid>
       </Border>
       <Grid Margin="0,19,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="投影片字體" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="FontPicker" Grid.Column="1" FontSize="15" Padding="10,7" DisplayMemberPath="DisplayName" SelectionChanged="Font_Changed"/></Grid>
      </StackPanel>
      <Grid Grid.Row="1">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,12"><Border DockPanel.Dock="Right" Background="#E9F0E5" CornerRadius="10" Padding="9,4"><TextBlock Text="16:9 · 文字只用上半部" FontSize="12" Foreground="#426B54"/></Border><TextBlock Text="投影片預覽" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <Border Grid.Row="1" Background="#E7EBE2" CornerRadius="8" ClipToBounds="True"><Viewbox x:Name="SlideHost" Stretch="Uniform"/></Border>
       <Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="PreviewInfo" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" Width="40" Padding="0,5" Click="Previous_Click" FontSize="20"/><Button Content="›" Width="40" Padding="0,5" Margin="7,0,0,0" Click="Next_Click" FontSize="20"/></StackPanel></Grid>
       <TextBlock Grid.Row="3" x:Name="ValidationText" Foreground="#A34F30" FontSize="13" Margin="0,12,0,0"/>
      </Grid>
     </Grid>
     <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="投影片" FontSize="16" FontWeight="SemiBold" Margin="3,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Thumbnails" Orientation="Vertical"/></ScrollViewer></DockPanel>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="已儲存" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="預覽整個崇拜" Click="Preview_Click" Margin="0,0,10,0"/><Button Content="製作 PowerPoint" Click="Export_Click" Style="{StaticResource Primary}"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>